{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "trenino",
  "version": "0.8.1",
  "identifier": "dev.restifo.tws-io",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/trenino_backend",
      "binaries/avrdude",
      "binaries/keystroke"
    ],
    "resources": [
      "binaries/avrdude.conf",
      "resources/vc_redist.x64.exe"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "macOS": {
      "entitlements": null,
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDMTdCRDVCODIzNjM2NEEKUldSS05qYUNXNzBYekttTExieVhjcStrdDREeG9PbjJmWThtUWlRdXdYTXpSUHQwWXUrckd1K04K",
      "endpoints": ["https://github.com/albertorestifo/trenino/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    },
    "shell": {
      "open": true
    }
  }
}
