# Temporary files, for example, from tests.
/tmp/

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log

# Database files
*.db
*.db-*

/.expert

# Claude Code local settings
.claude/*.local*

# Tauri build artifacts
/tauri/src-tauri/target/
/tauri/keystroke/target/
/tauri/node_modules/
/tauri/src-tauri/binaries/*.exe
/tauri/src-tauri/binaries/*-aarch64-apple-darwin
/tauri/src-tauri/binaries/*-x86_64-apple-darwin
/tauri/src-tauri/binaries/*-x86_64-unknown-linux-gnu
/tauri/src-tauri/binaries/*-x86_64-pc-windows-msvc

# VC++ Redistributable (downloaded in CI)
/tauri/src-tauri/resources/vc_redist.x64.exe

# Downloaded Windows packaging inputs (never signing keys or source files).
/tauri/src-tauri/binaries/avrdude.conf
/tauri/src-tauri/resources/vJoySetup.exe
/tauri/src-tauri/resources/vJoyConfig.exe
/tauri/src-tauri/resources/vJoyInstall.dll
/tauri/src-tauri/resources/vJoyInterface.dll
/tauri/src-tauri/resources/vJoy-LICENSE.txt

# Git worktrees
/.worktrees/
.superpowers/

# Rust workspace build output
/target/
/crates/*/target/
