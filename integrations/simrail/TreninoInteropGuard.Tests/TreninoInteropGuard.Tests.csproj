<Project Sdk="Microsoft.NET.Sdk">

  <!-- dotnet test integrations/simrail/TreninoInteropGuard.Tests -p:SimRailDir=... (GameAssembly tests skip without SimRail) -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <SimRailDir Condition="'$(SimRailDir)' == ''">D:\SteamLibrary\steamapps\common\SimRail</SimRailDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit.v3" Version="2.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TreninoInteropGuard\TreninoInteropGuard.csproj" Properties="DeployToGame=false" />
  </ItemGroup>

  <!-- The game's Iced when SimRail is installed, else the same version from NuGet (CI). -->
  <ItemGroup Condition="Exists('$(SimRailDir)\MelonLoader\net6\Iced.dll')">
    <Reference Include="Iced" HintPath="$(SimRailDir)\MelonLoader\net6\Iced.dll" Private="true" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(SimRailDir)\MelonLoader\net6\Iced.dll')">
    <PackageReference Include="Iced" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="TreninoInteropGuard.Tests.SimRailDirAttribute">
      <_Parameter1>$(SimRailDir)</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
